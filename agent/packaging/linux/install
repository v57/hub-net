#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "hub-net install: root privileges required" >&2
  exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
package_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
binary="$package_dir/hub-net"

if [ ! -x "$binary" ]; then
  echo "hub-net install: package binary missing: $binary" >&2
  exit 1
fi

install -d -m 0755 /usr/bin /usr/lib/systemd/system /usr/lib/sysusers.d /usr/lib/tmpfiles.d
install -m 0755 "$binary" /usr/bin/hub-net
install -m 0644 "$script_dir/hub-net.service" /usr/lib/systemd/system/hub-net.service
install -m 0644 "$script_dir/hub-net.sysusers" /usr/lib/sysusers.d/hub-net.conf
install -m 0644 "$script_dir/hub-net.tmpfiles" /usr/lib/tmpfiles.d/hub-net.conf

systemd-sysusers /usr/lib/sysusers.d/hub-net.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/hub-net.conf
systemctl daemon-reload
