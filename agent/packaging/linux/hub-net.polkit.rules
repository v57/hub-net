// The hub-net service runs as the unprivileged hub-net user, and systemd-resolved
// asks polkit before it changes a link's DNS. This lets the agent set the
// .hub.invalid routing domain and resolver on its WireGuard links (resolvectl
// dns, domain, default-route) and revert them, and nothing else. It already
// holds CAP_NET_ADMIN, which reaches further than these.
polkit.addRule(function(action, subject) {
    if (subject.user !== "hub-net") {
        return polkit.Result.NOT_HANDLED;
    }
    switch (action.id) {
    case "org.freedesktop.resolve1.set-dns-servers":
    case "org.freedesktop.resolve1.set-domains":
    case "org.freedesktop.resolve1.set-default-route":
    case "org.freedesktop.resolve1.revert":
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
